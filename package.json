{
  "name": "xBadiBot",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "franc-min": "6.2.0",
    "playwright": "1.64.1",
    "vite": "^8.3.4"
  },
  "scripts": {
    "vendor:languages": "node scripts/vendor-languages.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && tgcloud push",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "test:browser": "node scripts/browser-regressions.mjs"
  }
}
